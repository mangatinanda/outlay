    {
      "id": "plans_2026_06_15_redesign_02_design_foundation_font_wiring_fix",
      "label": "Font Wiring Fix (distinct loader variables)",
      "file_type": "rationale",
      "source_file": "docs/superpowers/plans/2026-06-15-redesign-02-design-foundation.md",
      "source_location": "Task 1",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "A next/font loader variable must never share the name of the Tailwind token it feeds: each loader gets a distinct variable (--font-geist-sans/--font-geist-mono/--font-jakarta) and @theme inline maps --font-sans/--font-mono/--font-display onto them, ending the serif fallback and adding Plus Jakarta Sans for headings."
    },
