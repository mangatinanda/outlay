    {
      "id": "specs_2026_06_05_deployable_serverless_pwa_design_deletemember_guard",
      "label": "deleteMember Orphan-Records Guard",
      "file_type": "concept",
      "source_file": "docs/superpowers/specs/2026-06-05-deployable-serverless-pwa-design.md",
      "source_location": "\u00a74E",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Deleting a member with existing expenses orphaned expenses.member_id; the guard mirrors the existing deleteCategory pattern and blocks deletion with an error instead."
    }
