    {
      "id": "specs_2026_06_05_deployable_serverless_pwa_design_turso_libsql",
      "label": "Turso/libSQL Driver Migration",
      "file_type": "rationale",
      "source_file": "docs/superpowers/specs/2026-06-05-deployable-serverless-pwa-design.md",
      "source_location": "\u00a74A",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "One driver (drizzle-orm/libsql) works for both local file: SQLite and cloud libsql:// Turso; the existing sqlite-core schema is reused unchanged, and better-sqlite3's filesystem assumptions do not work on serverless."
    },
    {
      "id": "specs_2026_06_05_deployable_serverless_pwa_design_passcode_gate",
      "label": "Shared Passcode Gate (Web Crypto HMAC he_session)",
      "file_type": "rationale",
      "source_file": "docs/superpowers/specs/2026-06-05-deployable-serverless-pwa-design.md",
      "source_location": "\u00a74C",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Single-tenant app: a shared passcode stops public read/write without the cost of full OAuth. Web Crypto (crypto.subtle HMAC-SHA256) is both Edge- and Node-safe so the same gate helper serves middleware and Server Actions with no JWT library."
    },
    {
