    {
      "id": "claude_model_b_auth",
      "label": "Model B Per-User Household Auth",
      "file_type": "rationale",
      "source_file": "CLAUDE.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Households are per-user, scoped by household_members.user_id. The shared passcode was repurposed as an explicit superadmin escalation at /admin rather than dropped (superseding the earlier 'drop the passcode' plan): an explicit secret god-mode key is the owner's deliberate escalation while Google users are scoped. Sign-in fails closed in prod (empty allow-list denies all) unless the email already has a membership/invite."
    },
    {
      "id": "claude_data_flow_pattern",
      "label": "Reads-via-Queries / Writes-via-Server-Actions Pattern",
      "file_type": "rationale",
      "source_file": "CLAUDE.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "No REST API is needed for CRUD: Server Components call lib/queries for reads and Client Components call Zod-validated, household-scoped Server Actions for writes, so validation and household scoping live at one boundary and every mutation returns { error } for foreign ids."
    },
    {
      "id": "claude_money_minor_units",
      "label": "Money as Integer Minor Units",
      "file_type": "rationale",
      "source_file": "CLAUDE.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Amounts are stored as integer minor units (expenses.amount_minor, fixed scale 100) so SQL sums are exact over integers; queries convert back with a single /100.0 at the boundary so components always see major units."
    },
