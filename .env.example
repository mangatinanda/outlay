# Local development — SQLite file accessed via the libSQL driver.
# The `file:` prefix is required.
DATABASE_URL=file:./data/expense.db

# Production — Turso / libSQL. Set these in your host's environment (e.g. Vercel),
# not in a committed file.
# DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# Secret used to sign the passcode-gate cookie AND the Auth.js (Google) JWT session.
# Generate with: openssl rand -base64 32
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Shared passcode that unlocks the app at /login.
HOUSEHOLD_PASSCODE=choose-a-shared-passcode

# --- Google sign-in (Auth.js v5) ---
# Create an OAuth 2.0 client + consent screen in Google Cloud Console.
# Authorized redirect URI must be EXACTLY: <origin>/api/auth/callback/google
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret

# Comma-separated allow-list of Google emails permitted to sign in.
# If empty, production FAILS CLOSED (no one) while dev allows everyone.
# Set to "*" to OPEN sign-up to ANY Google account — each new user gets their
# own private household (also requires publishing the Google OAuth consent
# screen as "External / In production").
HOUSEHOLD_ALLOWED_EMAILS=you@example.com,partner@example.com

# --- Abuse guardrails (matter most when HOUSEHOLD_ALLOWED_EMAILS=*) ---
# Bound how much the (free-tier) database can grow. Defaults shown below are
# applied when unset; lower them to tighten, raise to relax.
# MAX_USERS=1000                    # global cap on total accounts; new self-
#                                   #   service sign-ups stop here (existing
#                                   #   users always keep access)
# MAX_HOUSEHOLDS_PER_USER=10        # households one user can create
# MAX_EXPENSES_PER_HOUSEHOLD=50000  # expenses one household can hold

# Rate limits (bound the *speed* of writes; defaults shown). RATE_LIMIT_DISABLED
# ("1"/"true") turns the whole layer off.
# RATE_LIMIT_DISABLED=
# RATE_LIMIT_EXPENSES_PER_MIN=60      # expense writes per household per minute
# RATE_LIMIT_HOUSEHOLDS_PER_HOUR=10   # household creations per user per hour
# RATE_LIMIT_IMPORTS_PER_HOUR=5       # CSV imports per household per hour

# --- Scheduled cleanup of abandoned accounts (vercel.json cron) ---
# REQUIRED for the cron to run: Vercel sends this as a Bearer token; the route
# rejects anything else. Generate with: openssl rand -base64 32
CRON_SECRET=generate-with-openssl-rand-base64-32
# Days an account may sit with zero expenses before cleanup removes it (default 30).
# CLEANUP_RETENTION_DAYS=30
